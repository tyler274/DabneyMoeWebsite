project_id = "your-gcp-project-id"
region     = "us-central1"

# Set after the registry exists and the image has been pushed (phase 2):
# image = "us-central1-docker.pkg.dev/your-gcp-project-id/dabney/web:latest"

# Custom domain + Cloudflare DNS default to dabney.moe / enabled. Override if needed:
# custom_domain            = "dabney.moe"
# enable_cloudflare_dns    = false
# cloudflare_zone_id       = "your-cloudflare-zone-id"   # or CLOUDFLARE_ZONE_ID in Doppler
# google_site_verification = "token-from-search-console"     # value after google-site-verification=

# Secrets (cloudflare_api_token, doppler_token) should NOT live in this file.
# Pass them as environment variables instead, e.g.:
#   export TF_VAR_doppler_token=dp.pt.xxxx
#   export TF_VAR_cloudflare_api_token=cf-token-with-Zone:DNS:Edit
# Or, once they live in Doppler, inject the whole set automatically:
#   doppler run --name-transformer tf-var -- tofu apply

# Doppler (secrets management). Terraform creates this project + writes the
# deploy secrets into its prd config. Defaults are usually fine:
# doppler_project = "dabney-moe-website"
# doppler_config  = "prd"

# Cloud DNS path (unused when using Cloudflare):
# manage_dns = true
# dns_root   = "dabney.moe."

# Observability (optional). Pass tokens via TF_VAR_* - never commit them.
# export TF_VAR_grafana_cloud_access_policy_token=glc_xxxx
# grafana_cloud_region = "prod-eu-west-0"
# ga4_measurement_id   = "G-XXXXXXXX"
# ga4_property_id      = "123456789"
