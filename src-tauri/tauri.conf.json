{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dabney",
  "version": "0.1.0",
  "identifier": "moe.dabney.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "trunk serve",
    "beforeBuildCommand": "trunk build --release"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tyler Port — Freelance Software Engineer",
        "width": 1100,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Tyler Port — freelance software engineer.",
    "longDescription": "Tyler Port's resume and freelance software engineering portfolio — Rust, GPU computing, and high-performance systems.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
