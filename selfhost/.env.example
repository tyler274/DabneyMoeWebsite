# Copy to .env and edit. Used by docker-compose.yml + Caddyfile and
# maintained automatically by `scripts/deploy.sh --target ssh`.

# Email Let's Encrypt associates with the ACME account (expiry notices).
ACME_EMAIL=you@example.com

# Domain to serve + request a certificate for. Its DNS must point at this host.
SITE_DOMAIN=dabney.moe

# SSR server image. Default expects a locally-loaded Nix or Dockerfile image
# (`dabney-web:latest`); set to any OCI registry ref to pull instead, e.g.:
#   registry.gitlab.com/<user>/dabney-moe/web:latest
#   codeberg.org/<user>/dabney-web:latest
#   docker.io/<user>/dabney-web:latest
WEB_IMAGE=dabney-web:latest

# Optional runtime settings.
RUST_LOG=info
# CLINICAL_API_URL=
# GA4_MEASUREMENT_ID=
