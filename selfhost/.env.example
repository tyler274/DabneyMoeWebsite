# Copy to .env and edit. Used by docker-compose.yml + Caddyfile.

# Email Let's Encrypt associates with the ACME account (expiry notices).
ACME_EMAIL=you@example.com

# Domain to serve + request a certificate for. Its DNS must point at this host.
SITE_DOMAIN=dabney.moe

# SSR server image. Default expects a locally-loaded Nix image
# (`nix build .#serverImage && docker load < result`); set to a registry ref
# (e.g. ghcr.io/tyler274/dabney-web:latest) to pull instead.
WEB_IMAGE=dabney-web:latest
