# Secrets for the optional Coda demo profile (physician-sample, physician-worker,
# duet-api). Encrypt to secrets/coda.sops.env; never commit secrets/coda.env.

PHYSICIAN_DATABASE_URL=postgres://physician:<PHYSICIAN_DB_PASSWORD>@postgres/physician
DATABASE_URL=postgres://duet:<DUET_DB_PASSWORD>@postgres/duet

# Outbound mail through an EU relay with SMTP AUTH (Brevo or Scaleway TEM).
# MAIL_SMTP_* is read by coda-rust's `mail-relay` binary
# (gmail::SmtpRelayConfig::from_env) and applies to physician-sample / duet-api
# once those binaries wire SmtpRelayConfig::from_env (or route via mail-relay).
MAIL_SMTP_HOST=smtp.tem.scw.cloud
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
