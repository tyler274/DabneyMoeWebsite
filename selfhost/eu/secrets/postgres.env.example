# Secrets for postgres only. Fill a copy at secrets/postgres.env, encrypt it,
# and commit only the encrypted file:
#   sops encrypt --age <recipients> --input-type dotenv --output-type dotenv \
#     --output secrets/postgres.sops.env secrets/postgres.env
# scripts/deploy.sh decrypts secrets/*.sops.env on the host (mode 0600) with
# the host's age key. Never commit secrets/postgres.env.

POSTGRES_PASSWORD=
FORGE_DB_PASSWORD=
ATTIC_DB_PASSWORD=
POCKETID_DB_PASSWORD=
PHYSICIAN_DB_PASSWORD=
DUET_DB_PASSWORD=
