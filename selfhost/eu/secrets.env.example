# Container secrets for selfhost/eu. Fill a copy, encrypt it, and commit only
# the encrypted file:
#   sops encrypt --age <recipients> --input-type dotenv --output-type dotenv \
#     --output secrets.sops.env secrets.env
# scripts/deploy.sh decrypts secrets.sops.env on the host (mode 0600) with the
# host's age key. Never commit secrets.env.

POSTGRES_PASSWORD=
FORGE_DB_PASSWORD=
ATTIC_DB_PASSWORD=
POCKETID_DB_PASSWORD=
PHYSICIAN_DB_PASSWORD=
DUET_DB_PASSWORD=

ATTIC_SERVER_DATABASE_URL=postgres://attic:<ATTIC_DB_PASSWORD>@postgres/attic
ATTIC_SERVER_TOKEN_RS256_SECRET_BASE64=

DB_CONNECTION_STRING=postgres://pocketid:<POCKETID_DB_PASSWORD>@postgres/pocketid
ENCRYPTION_KEY=

FORGE_DATABASE_URL=postgres://forge:<FORGE_DB_PASSWORD>@postgres/forge

PHYSICIAN_DATABASE_URL=postgres://physician:<PHYSICIAN_DB_PASSWORD>@postgres/physician
DATABASE_URL=postgres://duet:<DUET_DB_PASSWORD>@postgres/duet

# Outbound mail through an EU relay with SMTP AUTH (Brevo or Scaleway TEM).
MAIL_SMTP_HOST=smtp.tem.scw.cloud
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
