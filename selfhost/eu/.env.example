# Non-secret settings for selfhost/eu/docker-compose.yml and the Caddyfile.
# Copy to .env; scripts/deploy.sh --target ssh --compose-dir selfhost/eu keeps
# SITE_DOMAIN and WEB_IMAGE current. Per-service secrets go in secrets/*.env
# (see secrets/*.env.example), decrypted on the host from secrets/*.sops.env.

# Let's Encrypt account email (expiry notices).
ACME_EMAIL=you@example.com

# Apex served by this host; git., coda., cache., auth., app. and api. hang off it.
SITE_DOMAIN=dabney.moe

# Images. Prefer EU registries: rg.fr-par.scw.cloud/<namespace>/... or codeberg.org/<user>/...
WEB_IMAGE=dabney-web:latest
FORGE_IMAGE=dabney-forge:latest
# FORGE_UPSTREAM=dabney-forge:8080
FORGE_SSH_PORT=2222
# RADICLE_IMAGE=radicle-node:latest
RADICLE_PORT=8776
# ATTIC_IMAGE=rg.fr-par.scw.cloud/dabney-moe/attic:latest
# POCKET_ID_IMAGE=rg.fr-par.scw.cloud/dabney-moe/pocket-id:v1
# CADDY_IMAGE=docker.io/library/caddy:2
# POSTGRES_IMAGE=docker.io/library/postgres:16
# VALKEY_IMAGE=docker.io/valkey/valkey:8

# Coda demo (docker compose --profile coda up -d).
# PHYSICIAN_IMAGE=rg.fr-par.scw.cloud/dabney-moe/physician-sample:latest
# DUET_IMAGE=rg.fr-par.scw.cloud/dabney-moe/duet-api:latest

# Enabled compose profiles: forge, coda, radicle (comma-separated).
# COMPOSE_PROFILES=forge,coda,radicle

RUST_LOG=info
# CLINICAL_API_URL=
